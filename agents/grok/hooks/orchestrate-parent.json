{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "repo hook orchestrate-parent",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "spawn_subagent|Task"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "repo hook orchestrate-parent",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "repo hook orchestrate-parent",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "repo hook orchestrate-parent",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "repo hook orchestrate-parent",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
