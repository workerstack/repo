{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo hook orchestrate-parent",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "spawn_subagent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "repo hook orchestrate-parent",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo hook orchestrate-parent",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo hook orchestrate-parent",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo hook orchestrate-parent",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
