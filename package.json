{
  "name": "@workerstack/repo",
  "version": "0.0.0",
  "private": false,
  "description": "Agent workflow, code standards, gates, workspace and docs checks for workerstack repos",
  "keywords": [
    "agents",
    "workerstack",
    "monorepo",
    "lint",
    "ci"
  ],
  "homepage": "https://github.com/workerstack/repo",
  "bugs": {
    "url": "https://github.com/workerstack/repo/issues"
  },
  "license": "MIT",
  "author": "workerstack",
  "repository": {
    "type": "git",
    "url": "https://github.com/workerstack/repo.git"
  },
  "bin": {
    "repo": "./bin/repo.js"
  },
  "exports": {
    ".": {
      "types": "./cli/config.ts",
      "default": "./cli/config.ts"
    },
    "./tsconfig/*": "./tsconfig/*.json",
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/repo.js",
    "cli",
    "tsconfig",
    "dist/*.js",
    "dist/*.d.ts",
    ".rulesync",
    "!.rulesync/scripts/**/*.test.ts",
    "!.rulesync/scripts/fixtures",
    "!.rulesync/lessons",
    ".grok",
    ".codex",
    ".claude",
    ".agents",
    "AGENTS.md",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "cross-spawn": "^7.0.6",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@vitest/coverage-v8": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "bun -e \"try{require('child_process').execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})}catch{}\" && bun ./bin/repo.js sync --postinstall",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
    "rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
    "rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
    "hooks:union": "node .rulesync/scripts/hooks-union.mjs",
    "hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
    "doctor": "node ./.rulesync/scripts/doctor.mjs",
    "clean": "node ./.rulesync/scripts/clean.mjs",
    "setup": "node ./.rulesync/scripts/setup.mjs",
    "tasks": "node .rulesync/scripts/vscode-tasks.mjs",
    "rulesync:doctor": "rulesync doctor",
    "sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
    "sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
    "sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
    "purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
    "purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
    "typecheck": "tsc -p .",
    "test": "bun ./bin/repo.js sync --check && tsc -p . && vitest run --coverage",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "rulesync": "43.7.0",
    "tar": "^7.5.22",
    "verdaccio": "^6.10.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
