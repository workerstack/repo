{
  "name": "@workerstack/repo",
  "version": "0.1.0",
  "private": false,
  "description": "Agent workflow, code standards, gates, workspace and docs checks for workerstack repos",
  "keywords": [
    "agents",
    "ci",
    "lint",
    "monorepo",
    "workerstack"
  ],
  "homepage": "https://github.com/workerstack/repo",
  "bugs": {
    "url": "https://github.com/workerstack/repo/issues"
  },
  "license": "MIT",
  "author": "Lovro Žagar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerstack/repo.git"
  },
  "bin": {
    "repo": "./bin/repo.ts"
  },
  "files": [
    "bin/repo.ts",
    "cli",
    "!cli/**/__fixtures__",
    "references",
    "tsconfig",
    "dist/presets/*.js",
    "dist/presets/*.d.ts",
    "dist/cli/env*.js",
    "dist/cli/env*.d.ts",
    "dist/cli/env/*.js",
    "dist/cli/env/*.d.ts",
    "dist/cli/json.js",
    "dist/cli/json.d.ts",
    "dist/cli/package-json.js",
    "dist/cli/package-json.d.ts",
    "dist/cli/repo-env*.js",
    "dist/cli/repo-env*.d.ts",
    "dist/cli/rust/floors*.js",
    "dist/cli/rust/floors*.d.ts",
    "dist/cli/sync-errors.js",
    "dist/cli/sync-errors.d.ts",
    "dist/cli/sync.constants.js",
    "dist/cli/sync.constants.d.ts",
    "agents",
    "!cli/scripts/**/*.test.ts",
    "!cli/lint/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./cli/config.ts",
      "default": "./cli/config.ts"
    },
    "./tsconfig/*": "./tsconfig/*.json",
    "./agents/*": "./agents/*",
    "./bench": {
      "types": "./cli/bench/spec.ts",
      "default": "./cli/bench/spec.ts"
    },
    "./env": {
      "types": "./cli/env/index.ts",
      "default": "./cli/env/index.ts"
    },
    "./lint": "./cli/lint/index.ts",
    "./tailwind": "./cli/lint/tailwind-plugin.ts",
    "./vitest": {
      "types": "./dist/presets/vitest.d.ts",
      "default": "./dist/presets/vitest.js"
    },
    "./references/*": "./references/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "bun ./dev/link-self.ts",
    "build": "bun --bun tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "doctor": "repo doctor",
    "clean": "repo clean",
    "setup": "repo setup",
    "tasks": "repo tasks",
    "yolo": "repo yolo",
    "yolo:check": "repo yolo --check",
    "purge:global-mcps": "repo purge-mcps",
    "purge:global-mcps:apply": "repo purge-mcps --apply",
    "typecheck": "bun --bun tsc -p .",
    "lint": "bun ./bin/repo.ts lint",
    "fmt": "bun ./bin/repo.ts fmt",
    "test": "bun --bun vitest run",
    "ci": "bun ./bin/repo.ts ci",
    "test:e2e": "bun --bun vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@clack/prompts": "^0.11.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "1.2.2",
    "@workerstack/references": "^0.1.1",
    "age-encryption": "0.3.1",
    "cross-spawn": "^7.0.6",
    "get-east-asian-width": "^1.7.0",
    "jscpd": "5.4.2",
    "jsonc-parser": "^3.3.1",
    "knip": "6.43.0",
    "oxc-parser": "0.157.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "smol-toml": "^1.8.0",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "turbo": "2.11.10",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "8.72.2",
    "@typescript-eslint/utils": "8.72.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "10.14.0",
    "oxlint-tailwindcss": "1.17.0",
    "tar": "^7.5.22",
    "verdaccio": "^6.10.5",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": ">=4",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/utils": "8.72.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "oxlint-tailwindcss": "1.17.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-plugin": {
      "optional": true
    },
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@stryker-mutator/core": {
      "optional": true
    },
    "@stryker-mutator/vitest-runner": {
      "optional": true
    },
    "@vitest/coverage-istanbul": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
