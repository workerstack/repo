{
  "name": "@workerstack/repo",
  "version": "0.0.0",
  "private": false,
  "description": "Agent workflow, code standards, gates, workspace and docs checks for workerstack repos",
  "keywords": [
    "agents",
    "workerstack",
    "monorepo",
    "lint",
    "ci"
  ],
  "homepage": "https://github.com/workerstack/repo",
  "bugs": {
    "url": "https://github.com/workerstack/repo/issues"
  },
  "license": "MIT",
  "author": "workerstack",
  "repository": {
    "type": "git",
    "url": "https://github.com/workerstack/repo.git"
  },
  "bin": {
    "repo": "./bin/repo.ts"
  },
  "exports": {
    ".": {
      "types": "./cli/config.ts",
      "default": "./cli/config.ts"
    },
    "./tsconfig/*": "./tsconfig/*.json",
    "./agents/*": "./agents/*",
    "./lint": "./cli/lint/index.ts",
    "./vitest": {
      "types": "./dist/presets/vitest.d.ts",
      "default": "./dist/presets/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/repo.ts",
    "cli",
    "!cli/sync/fixtures/consumer",
    "!cli/sync/fixtures/consumer-stock",
    "!cli/sync/fixtures/golden",
    "references",
    "tsconfig",
    "dist/presets/*.js",
    "dist/presets/*.d.ts",
    "dist/cli/env*.js",
    "dist/cli/env*.d.ts",
    "agents",
    "!cli/scripts/**/*.test.ts",
    "!cli/lint/**/*.test.ts",
    "!cli/scripts/fixtures",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@oxlint/plugins": "1.92.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "knip": "6.43.0",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": ">=4",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-istanbul": "^5.1.0",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-plugin": {
      "optional": true
    },
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@stryker-mutator/core": {
      "optional": true
    },
    "@stryker-mutator/vitest-runner": {
      "optional": true
    },
    "@vitest/coverage-istanbul": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "bun ./dev/link-self.ts",
    "build": "bun --bun tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "doctor": "repo doctor",
    "clean": "repo clean",
    "setup": "repo setup",
    "tasks": "repo tasks",
    "yolo": "repo yolo",
    "yolo:check": "repo yolo --check",
    "purge:global-mcps": "repo purge-mcps",
    "purge:global-mcps:apply": "repo purge-mcps --apply",
    "typecheck": "bun --bun tsc -p .",
    "lint": "bun ./bin/repo.ts lint",
    "fmt": "bun ./bin/repo.ts fmt",
    "test": "bun --bun vitest run",
    "ci": "bun ./bin/repo.ts ci",
    "test:e2e": "bun --bun vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^5.1.0",
    "tar": "^7.5.22",
    "verdaccio": "^6.10.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
