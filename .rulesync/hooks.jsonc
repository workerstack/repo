{
  "version": 1,
  "hooks": {
    // Claude / Codex / Antigravity / Cursor only (generate -t omits grokcli for hooks).
    // Cursor takes these matchers untranslated, so they name its tools too (Shell, Read, Write, Grep).
    // Grok spawn/fat SSOT is hand-placed .grok/hooks/orchestrate-parent.ts + orchestrate-parent.json.
    // Every command is rootCmd() from .rulesync/scripts/hooks-union.ts; hooks:check fails any other form.
    "preToolUse": [
      {
        "matcher": "spawn_subagent|Task|Agent|spawn_agent",
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook scrub-spawn-prompt",
        "timeout": 5
      },
      {
        // Fat Read/Grep/Glob/Bash + Write/Edit scratch rewrite. Writes are denied only to an implementer-* child (plan, journal) and to the parent while a review-* plan runs (outside .tmp/).
        "matcher": "Read|read_file|Grep|grep|Glob|list_dir|Bash|Shell|run_terminal_command|Write|Edit|write|search_replace|apply_patch|write_file|edit_file|run_command",
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook gate-fat-tools",
        "timeout": 5
      },
      {
        // Persist rewrite + fat-gate for session writes/reads. Grok json stays no-matcher (Read included).
        "matcher": "Write|Edit|write|search_replace|Bash|Shell|run_terminal_command|Skill|skill|run_command|Read|read_file|Grep|grep|Glob|list_dir",
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook orchestrate-parent",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        // Code-only folder map as additionalContext (hooks-union keeps it first).
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook session-map",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook orchestrate-parent",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook orchestrate-parent",
        "timeout": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook orchestrate-parent",
        "timeout": 30
      }
    ]
  },
  "claudecode": {
    // Claude Code only: claude -w, EnterWorktree and worktree subagents land in .worktrees/<name> on wt/<name>.
    "hooks": {
      "worktreeCreate": [{ "type": "command", "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook worktree", "timeout": 60 }],
      "worktreeRemove": [{ "type": "command", "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; b=node_modules/.bin/repo; [ -e \"$d/$b\" ] || [ -e \"$d/$b.exe\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; r=\"$d/$b\"; [ -e \"$r\" ] || [ ! -e \"$r.exe\" ] || r=\"$r.exe\"; [ -x \"$r\" ] || { echo \"repo: $d/$b is missing; run bun install\" >&2; exit 1; }; \"$r\" hook worktree", "timeout": 60 }]
    }
  }
}
