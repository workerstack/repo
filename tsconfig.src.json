{
  // exclude replaces tsconfig.json's own: its entries, then the tests and their helpers
  "exclude": [
    "node_modules",
    ".tmp",
    ".worktrees",
    "dist",
    "**/__fixtures__/**/ws/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.e2e.ts",
    "**/__fixtures__/**",
    "e2e",
    "*.config.ts"
  ],
  "extends": ["./tsconfig.json", "./tsconfig/strict.json"]
}
