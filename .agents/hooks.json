{
  "rulesync": {
    "PreToolUse": [
      {
        "matcher": "spawn_subagent|Task|Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; [ -e \"$d/.rulesync/scripts/scrub-spawn-prompt.mjs\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; node \"$d/.rulesync/scripts/scrub-spawn-prompt.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "(?:read_file|view_file)|read_file|Grep|grep|grep_search|Glob|list_dir|run_command|Shell|run_terminal_command|(?:write_file|write_to_file)|(?:edit_file|replace_file_content)|write|search_replace|apply_patch|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; [ -e \"$d/.rulesync/scripts/gate-fat-tools.mjs\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; node \"$d/.rulesync/scripts/gate-fat-tools.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "(?:write_file|write_to_file)|(?:edit_file|replace_file_content)|write|search_replace|run_command|Shell|run_terminal_command|Skill|skill|replace_file_content|run_command|(?:read_file|view_file)|read_file|Grep|grep|Glob|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; [ -e \"$d/.grok/hooks/orchestrate-parent.js\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; node \"$d/.grok/hooks/orchestrate-parent.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; [ -e \"$d/.rulesync/scripts/session-map.mjs\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; node \"$d/.rulesync/scripts/session-map.mjs\"",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "d=\"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\"; [ -e \"$d/.grok/hooks/orchestrate-parent.js\" ] || d=\"$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null || echo \"$d\")\"; node \"$d/.grok/hooks/orchestrate-parent.js\"",
        "timeout": 30
      }
    ]
  }
}
