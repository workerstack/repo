{
  "rulesync": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./scripts/guard.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "run_command"
      },
      {
        "hooks": [
          {
            "command": "bun run lint",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "(?:write_file|write_to_file)|(?:edit_file|replace_file_content)"
      }
    ],
    "SessionStart": [
      {
        "command": "echo session started",
        "timeout": 5,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "bun run test",
        "timeout": 120,
        "type": "command"
      }
    ]
  }
}
