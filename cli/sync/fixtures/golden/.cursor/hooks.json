{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "./scripts/guard.sh",
        "matcher": "Bash",
        "timeout": 10,
        "type": "command"
      },
      {
        "command": "bun run lint",
        "matcher": "Write|Edit",
        "timeout": 30,
        "type": "command"
      }
    ],
    "sessionStart": [
      {
        "command": "echo session started",
        "timeout": 5,
        "type": "command"
      }
    ],
    "stop": [
      {
        "command": "bun run test",
        "timeout": 120,
        "type": "command"
      }
    ]
  }
}
